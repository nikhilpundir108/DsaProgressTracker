# ==========================================
# DSATrack - Environment Configuration Template
# Copy this file to .env.local or .env and fill in your values
# ==========================================

# Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/dsatrack
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dsatrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dsatrack

# Authentication & Security
# Secret key used for signing JWT authentication tokens (generate a strong secret key)
JWT_SECRET=your_jwt_secret_key_here

# Shared API rate limiting (create a Redis database at https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Required only when inviting a new Super Admin
SUPER_ADMIN_REGISTRATION_KEY=replace_with_a_long_random_invitation_key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy OAuth configuration (optional; not used for authentication)
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

