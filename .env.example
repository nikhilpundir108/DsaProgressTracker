# ==========================================
# DSATrack - Environment Configuration Template
# Copy this file to .env.local or .env and fill in your values
# ==========================================

# Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/dsatrack
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dsatrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dsatrack

# Authentication & Security
# Secret key used for signing JWT authentication tokens (generate a strong secret key)
JWT_SECRET=your_jwt_secret_key_here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth / Google OAuth Configuration (Optional)
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
